# Optional OpenAI-compatible provider for plan drafting.
# Leave blank to use the clearly labelled local rule-based parser.
# When configured, the original request text is sent to this provider for plan drafting.
FORGE_LLM_BASE_URL=
FORGE_LLM_API_KEY=
FORGE_LLM_MODEL=
FORGE_LLM_ALLOW_INSECURE_LOCALHOST=false

# Optional local paths. The default database is data/forge.sqlite.
FORGE_DB_PATH=data/forge.sqlite
PORT=8787
